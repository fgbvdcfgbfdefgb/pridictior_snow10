# Snowflake Container Runtime: 4x A10 (23 GB), 48 vCPU, 100 GB RAM.
#   source configs/snowflake_4xa10.env && bash scripts/snowflake_train.sh
export SHARDS=data/btcusdt_1s
export CACHE=data/cache
export RUNS=runs/ensemble
export MODE=ensemble          # one variant per GPU, one shared CPU analyser
export STEPS=400000           # market-seconds replayed per rank (no epochs)
export ANALYSER_DEVICE=cpu    # set to 'cuda' for ~100x faster steps
export NPROC=4
