# Laptop / CI smoke test: no GPU, two recent months, a few hundred steps.
#   source configs/smoke_cpu.env && bash scripts/snowflake_train.sh
export SHARDS=data/btcusdt_1s
export CACHE=data/cache_smoke
export RUNS=runs/smoke
export MODE=ensemble
export STEPS=200
export ANALYSER_DEVICE=cpu
export NPROC=1
export START_MONTH=2026-08
export END_MONTH=2026-10
