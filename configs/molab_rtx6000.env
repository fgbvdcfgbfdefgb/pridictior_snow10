# molab, 1x RTX PRO 6000 (96 GB). Used for live serving, and optionally for
# a single-GPU fine-tune on the most recent weeks before going live.
export SHARDS=data/btcusdt_1s
export CACHE=data/cache
export RUNS=runs/molab
export MODE=ddp
export STEPS=50000
export ANALYSER_DEVICE=cuda   # 96 GB of VRAM: no reason to keep it on CPU here
export NPROC=1
export START_MONTH=2026-01
